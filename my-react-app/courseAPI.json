							"mode": "raw",
							"raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"pm.expect(json).to.have.property(\"token\");",
									"pm.collectionVariables.set(\"jwtToken\", json.token);",
									"if (json.id) {",
									"    pm.collectionVariables.set(\"authUserId\", json.id);",
									"}",
									"pm.collectionVariables.unset(\"courseId\");",
									"pm.collectionVariables.unset(\"sectionId\");",
									"pm.collectionVariables.unset(\"lessonId\");",
									"pm.collectionVariables.unset(\"enrollmentId\");",
									"pm.collectionVariables.unset(\"reviewId\");"
								]
							}
						}
					]
				}
			]
		},
